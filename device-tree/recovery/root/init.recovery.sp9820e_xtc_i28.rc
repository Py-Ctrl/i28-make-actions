import /init.recovery.usb.rc

#add for board init.rc for recovery mode
on post-fs


service gnss_download /system/bin/gnss_download
    class cali
    user system
    group system
    oneshot

on factorytest

on cali
    mkdir /data/gnss/ 0777 system system
    mkdir /data/gnss/bin/ 0777 system system
    mkdir /data/gnss/supl/ 0777 system system
    mkdir /data/gnss/config/ 0777 system system
    mkdir /data/gnss/lte/ 0777 system system
    chmod 666 /data/gnss/bin/gnssmodem.bin
    chmod 666 /data/gnss/config/config.xml
    chmod 666 /data/gnss/supl/supl.xml
    chmod 666 /data/gnss/supl/spirentroot.cer
    chmod 666 /data/gnss/lte/ext.eph
    chmod 666 /data/gnss/lte/jpleph.405
    chmod 666 /data/gnss/gnss.log
    chmod 666 /data/gnss/nmea.log
    chmod 666 /productinfo/tsx.dat
    chmod 666 /productinfo/txdata.txt
on factorytest
    mkdir /data/gnss/ 0777 system system
    mkdir /data/gnss/bin/ 0777 system system
    mkdir /data/gnss/supl/ 0777 system system
    mkdir /data/gnss/config/ 0777 system system
    mkdir /data/gnss/lte/ 0777 system system
    chmod 666 /data/gnss/bin/gnssmodem.bin
    chmod 666 /data/gnss/config/config.xml
    chmod 666 /data/gnss/supl/supl.xml
    chmod 666 /data/gnss/supl/spirentroot.cer
    chmod 666 /data/gnss/lte/ext.eph
    chmod 666 /data/gnss/lte/jpleph.405
    chmod 666 /data/gnss/gnss.log
    chmod 666 /data/gnss/nmea.log
    chmod 666 /productinfo/tsx.dat
    chmod 666 /productinfo/txdata.txt


service rpmbserver /system/bin/rpmbserver -r /dev/block/mmcblk0rpmb
    class cali
    socket rpmbserver stream 0666 rpmbserver rpmbserver
    group system
    seclabel u:r:tee:s0

#start storageproxyd must restorecon /data,
#not start storageproxyd on cali mode (not trigger post-fs-data)
on factorytest
    setprop sprd.storageproxyd.enabled 1

#on cali mode set sprd.storageproxyd.enabled=1 in production tools
on property:sprd.storageproxyd.enabled=1
    mkdir /data/sprd_ss 0770 system system
    start rpmbproxyd
    start storagensproxyd

#service name must be < 16
service rpmbproxyd /system/bin/sprdstorageproxyd -f rpmb -d /dev/trusty-ipc-dev0 -p /data/sprd_ss -r /dev/block/mmcblk0rpmb
    group system
    seclabel u:r:tee:s0

service storagensproxyd /system/bin/sprdstorageproxyd -f ns -d /dev/trusty-ipc-dev0 -p /data/sprd_ss -r /dev/block/mmcblk0rpmb
    group system
    seclabel u:r:tee:s0
    
# xtc-7s-reset control
on property:log.tag.s2reset=1
    write /sys/class/misc/sprd_7sreset/module_disable 0
    
on property:log.tag.s2reset=0
    write /sys/class/misc/sprd_7sreset/module_disable 1

on early-init
    # Create mount-point for ConfigFS USB gadgets
    mkdir /config
    mount configfs none /config
    # Add standard gadget entries
    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "Conf 1"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    write /config/usb_gadget/g1/configs/b.1/bmAttributes 0xc0
    # Create adb+ffs gadget function
    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 shell shell
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    # Create MTP and PTP functions
    mkdir /config/usb_gadget/g1/functions/mtp.gs0 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ptp.gs1 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/rndis.gs4 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/vser.gs7 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/accessory.gs2 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/audio_source.gs3 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/midi.gs5 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/mass_storage.gs6 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs0 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs1 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs2 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs3 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs4 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs5 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs6 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/gser.gs7 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ecm.gs0 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/mbim.gs0 0770 shell shell
    symlink /config/usb_gadget/g1/idVendor /sys/class/android_usb/android0/idVendor
    symlink /config/usb_gadget/g1/idProduct /sys/class/android_usb/android0/idProduct
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0xD001
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc.0.auto"
on property:sys.usb.config=none
    write /config/usb_gadget/g1/UDC "none"
    setprop sys.usb.ffs.ready 0
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
on property:sys.usb.config=mass_storage,adb
    write /config/usb_gadget/g1/functions/mass_storage.gs6/lun.0/cdrom 0
    write /config/usb_gadget/g1/functions/mass_storage.gs6/lun.0/ro 0
    write /config/usb_gadget/g1/functions/mass_storage.gs6/lun.0/nofua 1
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0xD001
    write /config/usb_gadget/g1/bcdDevice 0x0404
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mass_storage_adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    rm /config/usb_gadget/g1/configs/b.1/f6
    rm /config/usb_gadget/g1/configs/b.1/f7
    rm /config/usb_gadget/g1/configs/b.1/f8
    rm /config/usb_gadget/g1/configs/b.1/f9
    rm /config/usb_gadget/g1/configs/b.1/f10
    rm /config/usb_gadget/g1/configs/b.1/f11
    symlink /config/usb_gadget/g1/functions/mass_storage.gs6 /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    symlink /config/usb_gadget/g1/functions/gser.gs0 /config/usb_gadget/g1/configs/b.1/f3
    symlink /config/usb_gadget/g1/functions/gser.gs1 /config/usb_gadget/g1/configs/b.1/f4
    symlink /config/usb_gadget/g1/functions/gser.gs2 /config/usb_gadget/g1/configs/b.1/f5
    symlink /config/usb_gadget/g1/functions/gser.gs3 /config/usb_gadget/g1/configs/b.1/f6
    symlink /config/usb_gadget/g1/functions/gser.gs4 /config/usb_gadget/g1/configs/b.1/f7
    symlink /config/usb_gadget/g1/functions/gser.gs5 /config/usb_gadget/g1/configs/b.1/f8
    symlink /config/usb_gadget/g1/functions/gser.gs6 /config/usb_gadget/g1/configs/b.1/f9
    symlink /config/usb_gadget/g1/functions/gser.gs7 /config/usb_gadget/g1/configs/b.1/f10
    start adbd
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
on property:sys.usb.config=mtp,adb
    start adbd
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/bcdDevice 0xffff
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    rm /config/usb_gadget/g1/configs/b.1/f6
    rm /config/usb_gadget/g1/configs/b.1/f7
    rm /config/usb_gadget/g1/configs/b.1/f8
    rm /config/usb_gadget/g1/configs/b.1/f9
    rm /config/usb_gadget/g1/configs/b.1/f10
    rm /config/usb_gadget/g1/configs/b.1/f11
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    symlink /config/usb_gadget/g1/functions/gser.gs0 /config/usb_gadget/g1/configs/b.1/f3
    symlink /config/usb_gadget/g1/functions/gser.gs1 /config/usb_gadget/g1/configs/b.1/f4
    symlink /config/usb_gadget/g1/functions/gser.gs2 /config/usb_gadget/g1/configs/b.1/f5
    symlink /config/usb_gadget/g1/functions/gser.gs3 /config/usb_gadget/g1/configs/b.1/f6
    symlink /config/usb_gadget/g1/functions/gser.gs4 /config/usb_gadget/g1/configs/b.1/f7
    symlink /config/usb_gadget/g1/functions/gser.gs5 /config/usb_gadget/g1/configs/b.1/f8
    symlink /config/usb_gadget/g1/functions/gser.gs6 /config/usb_gadget/g1/configs/b.1/f9
    symlink /config/usb_gadget/g1/functions/gser.gs7 /config/usb_gadget/g1/configs/b.1/f10
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
on property:sys.usb.config=adb
    start adbd
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0xD001
    write /config/usb_gadget/g1/bcdDevice 0x0404
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    rm /config/usb_gadget/g1/configs/b.1/f6
    rm /config/usb_gadget/g1/configs/b.1/f7
    rm /config/usb_gadget/g1/configs/b.1/f8
    rm /config/usb_gadget/g1/configs/b.1/f9
    rm /config/usb_gadget/g1/configs/b.1/f10
    rm /config/usb_gadget/g1/configs/b.1/f11
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/gser.gs0 /config/usb_gadget/g1/configs/b.1/f2
    symlink /config/usb_gadget/g1/functions/gser.gs1 /config/usb_gadget/g1/configs/b.1/f3
    symlink /config/usb_gadget/g1/functions/gser.gs2 /config/usb_gadget/g1/configs/b.1/f4
    symlink /config/usb_gadget/g1/functions/gser.gs3 /config/usb_gadget/g1/configs/b.1/f5
    symlink /config/usb_gadget/g1/functions/gser.gs4 /config/usb_gadget/g1/configs/b.1/f6
    symlink /config/usb_gadget/g1/functions/gser.gs5 /config/usb_gadget/g1/configs/b.1/f7
    symlink /config/usb_gadget/g1/functions/gser.gs6 /config/usb_gadget/g1/configs/b.1/f8
    symlink /config/usb_gadget/g1/functions/gser.gs7 /config/usb_gadget/g1/configs/b.1/f9
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
# --- XTC i28 touch support -------------------------------------------------
# ueventd only creates flat /dev/eventN; TWRP scans /dev/input/ for evdev
# devices, so without this it sees no touchscreen and no power key.
on boot
    # cyttsp5 probe 会 disable 自己的 IRQ；Android 在 sys.boot_completed=1 时写
    # nobark 调 enable_cyttsp5_and_irq()（并启动看门狗定时器保持 IC 唤醒），
    # recovery 从不写 -> 没触摸。on boot 动作在本机已验证可执行（下面的 symlink 就生效了）。
    write /sys/kernel/bbk_softdog/bbkwatchdog "nobark"
    mkdir /dev/input 0755 root root
    symlink /dev/event0 /dev/input/event0
    symlink /dev/event1 /dev/input/event1
    symlink /dev/event2 /dev/input/event2
    symlink /dev/event3 /dev/input/event3
    symlink /dev/event4 /dev/input/event4
    symlink /dev/event5 /dev/input/event5
    symlink /dev/event6 /dev/input/event6
    symlink /dev/event7 /dev/input/event7
    symlink /dev/event8 /dev/input/event8

    # --- by-name links for TWRP recovery.fstab ---------------------------
    # Android 5.1 的 ueventd 会在 /dev/block/platform/<ctrl>/by-name/ 下自动
    # 建分区名链接；Android 9 的 ueventd 不再做这件事（内核 uevent 里仍有
    # PARTNAME，但没人用它建链接）。recovery.fstab 全部用 by-name 路径，
    # 链接缺失 => Actual_Block_Device 为空 => mount("") 返回 EINVAL，
    # 表现为 /system /cache /data /productinfo 全部 "Invalid argument"。
    # 映射取自内核 /sys/block/mmcblk0/mmcblk0p*/uevent 的 PARTNAME。
    mkdir /dev/block/platform 0755 root root
    mkdir /dev/block/platform/soc 0755 root root
    mkdir /dev/block/platform/soc/by-name 0755 root root
    mkdir /dev/block/by-name 0755 root root
    symlink /dev/block/mmcblk0p1 /dev/block/platform/soc/by-name/prodnv
    symlink /dev/block/mmcblk0p2 /dev/block/platform/soc/by-name/miscdata
    symlink /dev/block/mmcblk0p3 /dev/block/platform/soc/by-name/recovery
    symlink /dev/block/mmcblk0p4 /dev/block/platform/soc/by-name/misc
    symlink /dev/block/mmcblk0p5 /dev/block/platform/soc/by-name/trustos
    symlink /dev/block/mmcblk0p6 /dev/block/platform/soc/by-name/trustos_bak
    symlink /dev/block/mmcblk0p7 /dev/block/platform/soc/by-name/sml
    symlink /dev/block/mmcblk0p8 /dev/block/platform/soc/by-name/sml_bak
    symlink /dev/block/mmcblk0p9 /dev/block/platform/soc/by-name/uboot
    symlink /dev/block/mmcblk0p10 /dev/block/platform/soc/by-name/uboot_bak
    symlink /dev/block/mmcblk0p11 /dev/block/platform/soc/by-name/logo
    symlink /dev/block/mmcblk0p12 /dev/block/platform/soc/by-name/fbootlogo
    symlink /dev/block/mmcblk0p13 /dev/block/platform/soc/by-name/l_fixnv1
    symlink /dev/block/mmcblk0p14 /dev/block/platform/soc/by-name/l_fixnv2
    symlink /dev/block/mmcblk0p15 /dev/block/platform/soc/by-name/l_runtimenv1
    symlink /dev/block/mmcblk0p16 /dev/block/platform/soc/by-name/l_runtimenv2
    symlink /dev/block/mmcblk0p17 /dev/block/platform/soc/by-name/gpsgl
    symlink /dev/block/mmcblk0p18 /dev/block/platform/soc/by-name/gpsbd
    symlink /dev/block/mmcblk0p19 /dev/block/platform/soc/by-name/wcnmodem
    symlink /dev/block/mmcblk0p20 /dev/block/platform/soc/by-name/persist
    symlink /dev/block/mmcblk0p21 /dev/block/platform/soc/by-name/l_modem
    symlink /dev/block/mmcblk0p22 /dev/block/platform/soc/by-name/l_deltanv
    symlink /dev/block/mmcblk0p23 /dev/block/platform/soc/by-name/l_gdsp
    symlink /dev/block/mmcblk0p24 /dev/block/platform/soc/by-name/l_ldsp
    symlink /dev/block/mmcblk0p25 /dev/block/platform/soc/by-name/pm_sys
    symlink /dev/block/mmcblk0p26 /dev/block/platform/soc/by-name/boot
    symlink /dev/block/mmcblk0p27 /dev/block/platform/soc/by-name/system
    symlink /dev/block/mmcblk0p28 /dev/block/platform/soc/by-name/cache
    symlink /dev/block/mmcblk0p29 /dev/block/platform/soc/by-name/vendor
    symlink /dev/block/mmcblk0p30 /dev/block/platform/soc/by-name/expdb
    symlink /dev/block/mmcblk0p31 /dev/block/platform/soc/by-name/xtcinfo
    symlink /dev/block/mmcblk0p32 /dev/block/platform/soc/by-name/oem
    symlink /dev/block/mmcblk0p33 /dev/block/platform/soc/by-name/dloadflag
    symlink /dev/block/mmcblk0p34 /dev/block/platform/soc/by-name/xtcdata
    symlink /dev/block/mmcblk0p35 /dev/block/platform/soc/by-name/miscdat_bak
    symlink /dev/block/mmcblk0p36 /dev/block/platform/soc/by-name/nv_bak
    symlink /dev/block/mmcblk0p37 /dev/block/platform/soc/by-name/xtcdebug
    symlink /dev/block/mmcblk0p38 /dev/block/platform/soc/by-name/userdata
    symlink /dev/block/mmcblk0p1 /dev/block/by-name/prodnv
    symlink /dev/block/mmcblk0p2 /dev/block/by-name/miscdata
    symlink /dev/block/mmcblk0p3 /dev/block/by-name/recovery
    symlink /dev/block/mmcblk0p4 /dev/block/by-name/misc
    symlink /dev/block/mmcblk0p5 /dev/block/by-name/trustos
    symlink /dev/block/mmcblk0p6 /dev/block/by-name/trustos_bak
    symlink /dev/block/mmcblk0p7 /dev/block/by-name/sml
    symlink /dev/block/mmcblk0p8 /dev/block/by-name/sml_bak
    symlink /dev/block/mmcblk0p9 /dev/block/by-name/uboot
    symlink /dev/block/mmcblk0p10 /dev/block/by-name/uboot_bak
    symlink /dev/block/mmcblk0p11 /dev/block/by-name/logo
    symlink /dev/block/mmcblk0p12 /dev/block/by-name/fbootlogo
    symlink /dev/block/mmcblk0p13 /dev/block/by-name/l_fixnv1
    symlink /dev/block/mmcblk0p14 /dev/block/by-name/l_fixnv2
    symlink /dev/block/mmcblk0p15 /dev/block/by-name/l_runtimenv1
    symlink /dev/block/mmcblk0p16 /dev/block/by-name/l_runtimenv2
    symlink /dev/block/mmcblk0p17 /dev/block/by-name/gpsgl
    symlink /dev/block/mmcblk0p18 /dev/block/by-name/gpsbd
    symlink /dev/block/mmcblk0p19 /dev/block/by-name/wcnmodem
    symlink /dev/block/mmcblk0p20 /dev/block/by-name/persist
    symlink /dev/block/mmcblk0p21 /dev/block/by-name/l_modem
    symlink /dev/block/mmcblk0p22 /dev/block/by-name/l_deltanv
    symlink /dev/block/mmcblk0p23 /dev/block/by-name/l_gdsp
    symlink /dev/block/mmcblk0p24 /dev/block/by-name/l_ldsp
    symlink /dev/block/mmcblk0p25 /dev/block/by-name/pm_sys
    symlink /dev/block/mmcblk0p26 /dev/block/by-name/boot
    symlink /dev/block/mmcblk0p27 /dev/block/by-name/system
    symlink /dev/block/mmcblk0p28 /dev/block/by-name/cache
    symlink /dev/block/mmcblk0p29 /dev/block/by-name/vendor
    symlink /dev/block/mmcblk0p30 /dev/block/by-name/expdb
    symlink /dev/block/mmcblk0p31 /dev/block/by-name/xtcinfo
    symlink /dev/block/mmcblk0p32 /dev/block/by-name/oem
    symlink /dev/block/mmcblk0p33 /dev/block/by-name/dloadflag
    symlink /dev/block/mmcblk0p34 /dev/block/by-name/xtcdata
    symlink /dev/block/mmcblk0p35 /dev/block/by-name/miscdat_bak
    symlink /dev/block/mmcblk0p36 /dev/block/by-name/nv_bak
    symlink /dev/block/mmcblk0p37 /dev/block/by-name/xtcdebug
    symlink /dev/block/mmcblk0p38 /dev/block/by-name/userdata

# 兜底：TWRP 完成启动动作 / 配好 USB 时再写一次（幂等）。
# 注意：service 形式在 9.0 的 init 下实测不生效，必须用 on boot / on property 动作。
on property:twrp.action_complete=1
    write /sys/kernel/bbk_softdog/bbkwatchdog "nobark"

on property:sys.usb.config=mtp,adb
    write /sys/kernel/bbk_softdog/bbkwatchdog "nobark"

on property:sys.usb.config=adb
    write /sys/kernel/bbk_softdog/bbkwatchdog "nobark"
